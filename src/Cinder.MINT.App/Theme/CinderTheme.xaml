<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- CinderFilter DNA, cooled down into a mint / ultraviolet studio palette. -->
    <Color x:Key="CinderBackground">#060A0D</Color>
    <Color x:Key="CinderPanel">#0B1217</Color>
    <Color x:Key="CinderPanelRaised">#111B22</Color>
    <Color x:Key="CinderBorder">#29404A</Color>
    <Color x:Key="CinderText">#F2FFF9</Color>
    <Color x:Key="CinderMuted">#8FA7AA</Color>
    <Color x:Key="CinderGreen">#7DFFD6</Color>
    <Color x:Key="CinderPurple">#A76BFF</Color>
    <Color x:Key="CinderHot">#FF5FAA</Color>
    <Color x:Key="CinderWarning">#FFD36B</Color>
    <Color x:Key="CinderAqua">#42E8E0</Color>
    <Color x:Key="CinderMintDeep">#163A38</Color>

    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#071014" Offset="0"/>
        <GradientStop Color="#080B12" Offset="0.46"/>
        <GradientStop Color="#100A18" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource CinderPanel}"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource CinderPanelRaised}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource CinderBorder}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource CinderText}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource CinderMuted}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource CinderGreen}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource CinderPurple}"/>
    <SolidColorBrush x:Key="HotBrush" Color="{StaticResource CinderHot}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource CinderWarning}"/>
    <SolidColorBrush x:Key="AquaBrush" Color="{StaticResource CinderAqua}"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource CinderPanelRaised}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource CinderPanelRaised}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource CinderText}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource CinderPurple}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource CinderText}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource CinderMuted}"/>

    <LinearGradientBrush x:Key="CinderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource CinderGreen}" Offset="0"/>
        <GradientStop Color="{StaticResource CinderAqua}" Offset="0.42"/>
        <GradientStop Color="{StaticResource CinderPurple}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MintSurfaceGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#17252C" Offset="0"/>
        <GradientStop Color="#0D171D" Offset="0.55"/>
        <GradientStop Color="#151020" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MintHeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#CC102029" Offset="0"/>
        <GradientStop Color="#CC0D131B" Offset="0.58"/>
        <GradientStop Color="#CC15101F" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="GreenGlow" Color="{StaticResource CinderGreen}" BlurRadius="24" ShadowDepth="0" Opacity="0.34"/>
    <DropShadowEffect x:Key="PurpleGlow" Color="{StaticResource CinderPurple}" BlurRadius="24" ShadowDepth="0" Opacity="0.32"/>
    <DropShadowEffect x:Key="AquaGlow" Color="{StaticResource CinderAqua}" BlurRadius="28" ShadowDepth="0" Opacity="0.26"/>
    <DropShadowEffect x:Key="PopupShadow" Color="#000000" BlurRadius="34" ShadowDepth="9" Opacity="0.72"/>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.48"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MintSurfaceGradient}"/>
        <Setter Property="BorderBrush" Value="#35505A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <Style x:Key="InspectorCard" TargetType="Border" BasedOn="{StaticResource PanelCard}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F3101C22" Offset="0"/>
                    <GradientStop Color="#F20C151B" Offset="0.58"/>
                    <GradientStop Color="#F3161022" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
        <Setter Property="BorderThickness" Value="1.3"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect" Value="{StaticResource PopupShadow}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="#152129"/>
        <Setter Property="BorderBrush" Value="#36505B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
                            <Setter TargetName="Root" Property="Background" Value="#1B2C33"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.76"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#06100F"/>
        <Setter Property="Background" Value="{StaticResource CinderGradient}"/>
        <Setter Property="BorderBrush" Value="#B5FFF0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Effect" Value="{StaticResource GreenGlow}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="#0B151B"/>
        <Setter Property="BorderBrush" Value="#35505A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="CaretBrush" Value="{StaticResource GreenBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource PurpleBrush}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="#0B151B"/>
        <Setter Property="BorderBrush" Value="#35505A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,8,38,8"/>
        <Setter Property="MaxDropDownHeight" Value="380"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  IsHitTestVisible="False"/>
                                <Border Width="34"
                                        HorizontalAlignment="Right"
                                        Background="#14242B"
                                        CornerRadius="0,9,9,0">
                                    <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                          Fill="{StaticResource GreenBrush}"
                                          Width="10" Height="5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ToggleButton Focusable="False"
                                      ClickMode="Press"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, ElementName=Face}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,5,0,0"
                                    Background="#F5111B22"
                                    BorderBrush="{StaticResource GreenBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Effect="{StaticResource PopupShadow}">
                                <ScrollViewer Margin="3"
                                              CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource PurpleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="#111B22"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="7"
                            Margin="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#213735"/>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#2B2141"/>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PurpleBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#091116"/>
        <Setter Property="Foreground" Value="#3B5963"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
        <Setter Property="Margin" Value="0,7,0,9"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="9"/>
        <Setter Property="Background" Value="#17242B"/>
        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" Background="Transparent"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="TinyLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
</ResourceDictionary>