<Window x:Class="Cinder.MINT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cinder.MINT.Controls"
        Title="Cinder MINT"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="88"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="#0C0E16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource CinderGradient}" Effect="{StaticResource GreenGlow}">
                            <TextBlock Text="M" Foreground="#080910" FontWeight="Black" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="CINDER MINT" FontWeight="Black" FontSize="18"/>
                            <TextBlock Text="machine-intelligent normalization &amp; tone" Style="{StaticResource TinyLabel}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16,7">
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Width="42" Height="34" Padding="0" Click="Minimize_Click"/>
                        <Button Content="□" Width="42" Height="34" Padding="0" Margin="5,0,0,0" Click="Maximize_Click"/>
                        <Button Content="×" Width="42" Height="34" Padding="0" Margin="5,0,0,0"
                                Background="#381722" BorderBrush="{StaticResource HotBrush}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Sources -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="VOICE / RVC LANE" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Margin="0,5,0,12" TextWrapping="Wrap"
                                           Text="Select a microphone, virtual microphone, or the render endpoint carrying RVC output."
                                           Style="{StaticResource TinyLabel}"/>
                                <ComboBox ItemsSource="{Binding VoiceSources}"
                                          SelectedItem="{Binding SelectedVoiceSource}"
                                          DisplayMemberPath="DisplayName"/>
                                <TextBlock Text="VOICE PRESET" Margin="0,16,0,5" Style="{StaticResource TinyLabel}"/>
                                <ComboBox ItemsSource="{Binding VoicePresetNames}"
                                          SelectedItem="{Binding SelectedVoicePreset}"/>
                                <CheckBox Content="Adaptive set-and-forget control"
                                          IsChecked="{Binding VoiceProfile.AutoMode}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="MUSIC / APP LANE" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Margin="0,5,0,12" TextWrapping="Wrap"
                                           Text="Route the chosen app to a dedicated Windows/VB endpoint, then select that endpoint here."
                                           Style="{StaticResource TinyLabel}"/>
                                <ComboBox ItemsSource="{Binding ProgramSources}"
                                          SelectedItem="{Binding SelectedProgramSource}"
                                          DisplayMemberPath="Name"/>
                                <TextBlock Text="PROGRAM PRESET" Margin="0,16,0,5" Style="{StaticResource TinyLabel}"/>
                                <ComboBox ItemsSource="{Binding ProgramPresetNames}"
                                          SelectedItem="{Binding SelectedProgramPreset}"/>
                                <CheckBox Content="Automatic loudness riding"
                                          IsChecked="{Binding ProgramProfile.AutoMode}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="STREAM OUTPUT" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Margin="0,5,0,12" TextWrapping="Wrap"
                                           Text="Choose the endpoint OBS or VoiceMeeter will capture, usually a spare VB-Cable."
                                           Style="{StaticResource TinyLabel}"/>
                                <ComboBox ItemsSource="{Binding Outputs}"
                                          SelectedItem="{Binding SelectedOutput}"
                                          DisplayMemberPath="Name"/>
                                <TextBlock Text="BUFFER / LATENCY" Margin="0,16,0,0" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="10" Maximum="120" TickFrequency="5"
                                        Value="{Binding LatencyMs}" IsSnapToTickEnabled="True"/>
                                <TextBlock Text="{Binding LatencyMs, StringFormat={}{0} ms}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource PurpleBrush}" FontWeight="Bold"/>
                                <CheckBox Content="Reconnect and resume automatically"
                                          IsChecked="{Binding AutoStart}" Margin="0,10,0,0"/>
                                <Button Content="REFRESH DEVICES" Margin="0,12,0,0" Click="Refresh_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Visual graph -->
                <Border Grid.Column="1" Margin="12,0" Style="{StaticResource PanelCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#0D0F18" CornerRadius="14,14,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid Margin="14,0">
                                <TextBlock Text="SIGNAL GRAPH" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <TextBlock Text="drag nodes • double-click a processor to bypass"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TinyLabel}"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <controls:NodeGraphCanvas x:Name="GraphCanvas"
                                                      Width="1560" Height="430"
                                                      Graph="{Binding Graph}"
                                                      NodeToggled="GraphCanvas_NodeToggled"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Advanced controls -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="VOICE DETAIL" Style="{StaticResource SectionLabel}"/>

                                <TextBlock Text="Input trim" Margin="0,12,0,0" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="-12" Maximum="18" Value="{Binding VoiceProfile.InputGainDb}"/>
                                <TextBlock Text="{Binding VoiceProfile.InputGainDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right"/>

                                <TextBlock Text="Smart gate floor" Margin="0,8,0,0" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="-72" Maximum="-28" Value="{Binding VoiceProfile.GateThresholdDb}"/>
                                <TextBlock Text="{Binding VoiceProfile.GateThresholdDb, StringFormat={}{0:F0} dB}" HorizontalAlignment="Right"/>

                                <TextBlock Text="Rumble / plosive cut" Margin="0,8,0,0" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="35" Maximum="180" Value="{Binding VoiceProfile.HighPassHz}"/>
                                <TextBlock Text="{Binding VoiceProfile.HighPassHz, StringFormat={}{0:F0} Hz}" HorizontalAlignment="Right"/>

                                <TextBlock Text="Adaptive de-essing" Margin="0,8,0,0" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding VoiceProfile.DeEsserAmount}"/>
                                <TextBlock Text="{Binding VoiceProfile.DeEsserAmount, StringFormat={}{0:P0}}" HorizontalAlignment="Right"/>

                                <TextBlock Text="Compression" Margin="0,8,0,0" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding VoiceProfile.Compression}"/>
                                <TextBlock Text="{Binding VoiceProfile.Compression, StringFormat={}{0:P0}}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="PROGRAM DETAIL" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Loudness target" Margin="0,12,0,0" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="-30" Maximum="-14" Value="{Binding ProgramProfile.TargetDb}"/>
                                <TextBlock Text="{Binding ProgramProfile.TargetDb, StringFormat={}{0:F0} dB adaptive target}" HorizontalAlignment="Right"/>

                                <TextBlock Text="Compression" Margin="0,8,0,0" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding ProgramProfile.Compression}"/>
                                <TextBlock Text="{Binding ProgramProfile.Compression, StringFormat={}{0:P0}}" HorizontalAlignment="Right"/>

                                <TextBlock Text="Duck under voice" Margin="0,8,0,0" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="-18" Maximum="0" Value="{Binding ProgramProfile.DuckingDb}"/>
                                <TextBlock Text="{Binding ProgramProfile.DuckingDb, StringFormat={}{0:F0} dB}" HorizontalAlignment="Right"/>

                                <TextBlock Text="Master ceiling" Margin="0,8,0,0" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="-6" Maximum="-0.1" Value="{Binding MasterProfile.LimiterCeilingDb}"/>
                                <TextBlock Text="{Binding MasterProfile.LimiterCeilingDb, StringFormat={}{0:F1} dBFS}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="EQ — VOICE" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Low shelf" Margin="0,10,0,0" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="-8" Maximum="8" Value="{Binding VoiceProfile.LowGainDb}"/>
                                <TextBlock Text="Mid presence" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="-8" Maximum="8" Value="{Binding VoiceProfile.MidGainDb}"/>
                                <TextBlock Text="Air / brightness" Style="{StaticResource TinyLabel}"/>
                                <Slider Minimum="-8" Maximum="8" Value="{Binding VoiceProfile.HighGainDb}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Transport and meters -->
            <Border Grid.Row="2" Background="#0C0E16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="START MINT" Style="{StaticResource PrimaryButton}" Width="132" Height="48" Click="Start_Click"/>
                        <Button Content="STOP" Width="72" Height="48" Margin="8,0,0,0" Click="Stop_Click"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="28,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="VOICE/RVC" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="0" Grid.Column="1" Height="8" Maximum="100" Value="{Binding VoiceMeter}"
                                     Foreground="{StaticResource GreenBrush}" Background="#272A38"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding VoiceMeter, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1" Text="MUSIC/APP" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" Height="8" Maximum="100" Value="{Binding ProgramMeter}"
                                     Foreground="{StaticResource PurpleBrush}" Background="#272A38"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ProgramMeter, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2" Text="MASTER" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="2" Grid.Column="1" Height="8" Maximum="100" Value="{Binding MasterMeter}"
                                     Foreground="{StaticResource HotBrush}" Background="#272A38"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MasterMeter, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="48 kHz • 32-bit float" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="deterministic DSP • no fabricated audio" Style="{StaticResource TinyLabel}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
