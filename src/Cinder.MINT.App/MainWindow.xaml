<Window x:Class="Cinder.MINT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cinder.MINT.Controls"
        xmlns:models="clr-namespace:Cinder.MINT.Models"
        Title="Cinder MINT"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="InspectorSection" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BackgroundBrush}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="88"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0C0E16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource CinderGradient}" Effect="{StaticResource GreenGlow}">
                            <TextBlock Text="M" Foreground="#080910" FontWeight="Black" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="CINDER MINT" FontWeight="Black" FontSize="18"/>
                            <TextBlock Text="free-form intelligent audio patchbay" Style="{StaticResource TinyLabel}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16,7">
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Width="42" Height="34" Padding="0" Click="Minimize_Click"/>
                        <Button Content="□" Width="42" Height="34" Padding="0" Margin="5,0,0,0" Click="Maximize_Click"/>
                        <Button Content="×" Width="42" Height="34" Padding="0" Margin="5,0,0,0"
                                Background="#381722" BorderBrush="{StaticResource HotBrush}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#0D0F18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding NodePalette}"
                              SelectedItem="{Binding SelectedPaletteItem}"/>
                    <Button Grid.Column="1" Content="ADD NODE" Margin="8,0,0,0" Click="AddNode_Click"/>
                    <Button Grid.Column="2" Content="RESET PATCH" Margin="8,0,0,0" Click="ResetGraph_Click"/>
                    <Button Grid.Column="3" Content="REFRESH DEVICES" Margin="8,0,0,0" Click="Refresh_Click"/>
                    <CheckBox Grid.Column="4" Content="Auto-recover and resume"
                              IsChecked="{Binding AutoStart}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <TextBlock Grid.Column="5"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource TinyLabel}"
                               Text="drag sockets to patch • right-click a socket to unplug • double-click a processor to bypass • Delete removes selected node"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="14" Style="{StaticResource PanelCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#0D0F18" CornerRadius="14,14,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="14,0">
                            <TextBlock Text="PATCH CANVAS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Text="sources, processors, buses and outputs all live here"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TinyLabel}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="GraphScroll"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="GraphScroll_ScrollChanged">
                        <controls:NodeGraphCanvas x:Name="GraphCanvas"
                                                  Width="2200" Height="1100"
                                                  Graph="{Binding Graph}"
                                                  NodeToggled="GraphCanvas_NodeToggled"
                                                  NodeMoved="GraphCanvas_NodeMoved"
                                                  NodeDeleteRequested="GraphCanvas_NodeDeleteRequested"
                                                  NodeSelected="GraphCanvas_NodeSelected"
                                                  ConnectionChanged="GraphCanvas_ConnectionChanged"
                                                  ConnectionRejected="GraphCanvas_ConnectionRejected"/>
                    </ScrollViewer>

                    <Popup x:Name="InspectorPopup"
                           PlacementTarget="{Binding ElementName=RootGrid}"
                           Placement="Relative"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           PopupAnimation="Fade">
                        <Border x:Name="InspectorCard" Width="350" MaxHeight="650" Style="{StaticResource InspectorCard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="NODE OPTIONS" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock Text="{Binding SelectedNode.Type}" Style="{StaticResource TinyLabel}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="×" Width="32" Height="28" Padding="0" Click="CloseInspector_Click"/>
                                    </Grid>

                                    <TextBlock Text="Node name" Style="{StaticResource TinyLabel}" Margin="0,14,0,5"/>
                                    <TextBox Text="{Binding SelectedNode.Title, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Content="Enabled" IsChecked="{Binding SelectedNode.Enabled}" Margin="0,10,0,0"/>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Input}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="INPUT ENDPOINT" Style="{StaticResource SectionLabel}"/>
                                        <ComboBox ItemsSource="{Binding Sources}"
                                                  SelectedItem="{Binding SelectedNode.Endpoint, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="EndpointSelection_Changed"
                                                  Margin="0,7,0,4"/>
                                        <CheckBox Content="Use as voice-activity source"
                                                  IsChecked="{Binding SelectedNode.IsVoiceActivitySource}"/>
                                        <TextBlock Text="Input trim" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="-18" Maximum="24" Value="{Binding SelectedNode.Profile.InputGainDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.InputGainDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Capture latency" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="10" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding SelectedNode.LatencyMs}"/>
                                        <TextBlock Text="{Binding SelectedNode.LatencyMs, StringFormat={}{0} ms}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Output}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="OUTPUT ENDPOINT" Style="{StaticResource SectionLabel}"/>
                                        <ComboBox ItemsSource="{Binding Outputs}"
                                                  SelectedItem="{Binding SelectedNode.Endpoint, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="EndpointSelection_Changed"
                                                  Margin="0,7,0,4"/>
                                        <TextBlock Text="Output latency" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="10" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding SelectedNode.LatencyMs}"/>
                                        <TextBlock Text="{Binding SelectedNode.LatencyMs, StringFormat={}{0} ms}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Gain}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="GAIN / TRIM" Style="{StaticResource SectionLabel}"/>
                                        <Slider Minimum="-24" Maximum="24" Value="{Binding SelectedNode.Profile.InputGainDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.InputGainDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.NoiseGate}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="SMART GATE" Style="{StaticResource SectionLabel}"/>
                                        <CheckBox Content="Adaptive noise-floor tracking" IsChecked="{Binding SelectedNode.Profile.AutoMode}"/>
                                        <TextBlock Text="Floor / threshold" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="-72" Maximum="-20" Value="{Binding SelectedNode.Profile.GateThresholdDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.GateThresholdDb, StringFormat={}{0:F0} dB}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Release" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="30" Maximum="600" Value="{Binding SelectedNode.Profile.GateReleaseMs}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.GateReleaseMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.HighPass}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="RUMBLE / PLOSIVE CUT" Style="{StaticResource SectionLabel}"/>
                                        <Slider Minimum="30" Maximum="220" Value="{Binding SelectedNode.Profile.HighPassHz}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.HighPassHz, StringFormat={}{0:F0} Hz}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.DeEsser}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="ADAPTIVE DE-ESSER" Style="{StaticResource SectionLabel}"/>
                                        <CheckBox Content="Adaptive detection" IsChecked="{Binding SelectedNode.Profile.AutoMode}"/>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding SelectedNode.Profile.DeEsserAmount}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.DeEsserAmount, StringFormat={}{0:P0}}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Equalizer}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="THREE-BAND EQ" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="Low shelf" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="-12" Maximum="12" Value="{Binding SelectedNode.Profile.LowGainDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.LowGainDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Mid presence" Style="{StaticResource TinyLabel}"/>
                                        <Slider Minimum="-12" Maximum="12" Value="{Binding SelectedNode.Profile.MidGainDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.MidGainDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="High shelf / air" Style="{StaticResource TinyLabel}"/>
                                        <Slider Minimum="-12" Maximum="12" Value="{Binding SelectedNode.Profile.HighGainDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.HighGainDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.LevelRider}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="LEVEL RIDER" Style="{StaticResource SectionLabel}"/>
                                        <CheckBox Content="Adaptive set-and-forget control" IsChecked="{Binding SelectedNode.Profile.AutoMode}"/>
                                        <TextBlock Text="Loudness target" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="-32" Maximum="-12" Value="{Binding SelectedNode.Profile.TargetDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.TargetDb, StringFormat={}{0:F0} dB target}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Ride speed" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="250" Maximum="3000" Value="{Binding SelectedNode.Profile.RiderSpeedMs}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.RiderSpeedMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Compressor}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="COMPRESSOR" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="Strength" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding SelectedNode.Profile.Compression}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.Compression, StringFormat={}{0:P0}}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Attack" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="1" Maximum="100" Value="{Binding SelectedNode.Profile.CompressorAttackMs}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.CompressorAttackMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Release" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="30" Maximum="1000" Value="{Binding SelectedNode.Profile.CompressorReleaseMs}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.CompressorReleaseMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Ducker}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="SIDECHAIN DUCKER" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="Patch program audio to MAIN and the trigger source to the pink SIDECHAIN socket."
                                                   TextWrapping="Wrap" Style="{StaticResource TinyLabel}" Margin="0,5,0,7"/>
                                        <TextBlock Text="Duck depth" Style="{StaticResource TinyLabel}"/>
                                        <Slider Minimum="-30" Maximum="0" Value="{Binding SelectedNode.Profile.DuckingDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.DuckingDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Trigger threshold" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="-72" Maximum="-6" Value="{Binding SelectedNode.Profile.DuckerThresholdDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.DuckerThresholdDb, StringFormat={}{0:F0} dB}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Attack" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="1" Maximum="500" Value="{Binding SelectedNode.Profile.DuckerAttackMs}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.DuckerAttackMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Release" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="20" Maximum="3000" Value="{Binding SelectedNode.Profile.DuckerReleaseMs}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.DuckerReleaseMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Mixer}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="MIX BUS" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="The MIX IN socket accepts as many cables as you need. Its output can be split to multiple destinations."
                                                   TextWrapping="Wrap" Style="{StaticResource TinyLabel}" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource InspectorSection}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Limiter}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="LIMITER" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="Ceiling" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="-12" Maximum="-0.1" Value="{Binding SelectedNode.Profile.LimiterCeilingDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.LimiterCeilingDb, StringFormat={}{0:F1} dBFS}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Release" Style="{StaticResource TinyLabel}" Margin="0,8,0,0"/>
                                        <Slider Minimum="10" Maximum="1000" Value="{Binding SelectedNode.Profile.LimiterReleaseMs}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.LimiterReleaseMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <Button Content="DELETE NODE" Margin="0,16,0,0"
                                            Background="#381722" BorderBrush="{StaticResource HotBrush}"
                                            Click="DeleteSelected_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="#0C0E16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="START MINT" Style="{StaticResource PrimaryButton}" Width="132" Height="48" Click="Start_Click"/>
                        <Button Content="STOP" Width="72" Height="48" Margin="8,0,0,0" Click="Stop_Click"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="28,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="VOICE SRC" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="0" Grid.Column="1" Height="8" Maximum="100" Value="{Binding VoiceMeter, Mode=OneWay}"
                                     Foreground="{StaticResource GreenBrush}" Background="#272A38"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding VoiceMeter, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1" Text="PROGRAM" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" Height="8" Maximum="100" Value="{Binding ProgramMeter, Mode=OneWay}"
                                     Foreground="{StaticResource PurpleBrush}" Background="#272A38"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ProgramMeter, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2" Text="MASTER" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="2" Grid.Column="1" Height="8" Maximum="100" Value="{Binding MasterMeter, Mode=OneWay}"
                                     Foreground="{StaticResource HotBrush}" Background="#272A38"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MasterMeter, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="48 kHz • 32-bit float" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="deterministic DSP • freely patched" Style="{StaticResource TinyLabel}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
