<Window x:Class="Cinder.MINT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cinder.MINT.Controls"
        xmlns:models="clr-namespace:Cinder.MINT.Models"
        Title="Cinder MINT"
        Width="1480"
        Height="920"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="InspectorSection" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="IntentLabel" TargetType="TextBlock" BasedOn="{StaticResource TinyLabel}">
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Background="{StaticResource BackgroundBrush}"
            CornerRadius="18">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="92"/>
            </Grid.RowDefinitions>

            <!-- title -->
            <Border Grid.Row="0"
                    Background="#D90A1518"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38"
                                CornerRadius="13"
                                Background="{StaticResource CinderGradient}"
                                Effect="{StaticResource GreenGlow}">
                            <TextBlock Text="M"
                                       Foreground="#071115"
                                       FontWeight="Black"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="CINDER MINT" FontWeight="Black" FontSize="19"/>
                            <TextBlock Text="independent AI brains • bounded DSP • free-form patching"
                                       Style="{StaticResource TinyLabel}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#A60E1B20"
                            BorderBrush="{StaticResource GreenBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18,8">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Width="42" Height="34" Padding="0" Click="Minimize_Click"/>
                        <Button Content="□" Width="42" Height="34" Padding="0" Margin="5,0,0,0" Click="Maximize_Click"/>
                        <Button Content="×" Width="42" Height="34" Padding="0" Margin="5,0,0,0"
                                Background="#381722" BorderBrush="{StaticResource HotBrush}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- node shelf -->
            <Border Grid.Row="1"
                    Background="#C90B1519"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding NodePalette}"
                              SelectedItem="{Binding SelectedPaletteItem}"/>
                    <Button Grid.Column="1" Content="+ ADD NODE" Margin="8,0,0,0" Click="AddNode_Click"/>
                    <Button Grid.Column="2" Content="RESET TO AI PATCH" Margin="8,0,0,0" Click="ResetGraph_Click"/>
                    <Button Grid.Column="3" Content="REFRESH DEVICES" Margin="8,0,0,0" Click="Refresh_Click"/>
                    <CheckBox Grid.Column="4"
                              Content="Auto-recover"
                              IsChecked="{Binding AutoStart}"
                              VerticalAlignment="Center"
                              Margin="18,0,0,0"/>
                    <TextBlock Grid.Column="5"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource TinyLabel}"
                               Text="drag sockets to patch  •  right-click socket to unplug  •  double-click node to bypass"/>
                </Grid>
            </Border>

            <!-- graph -->
            <Border Grid.Row="2"
                    Margin="14"
                    Style="{StaticResource PanelCard}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#B90A1519"
                            CornerRadius="16,16,0,0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="15,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="MINTYBAY" Style="{StaticResource SectionLabel}"/>
                                <Border Margin="10,0,0,0"
                                        Background="#223AF0C4"
                                        BorderBrush="{StaticResource GreenBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="8,3">
                                    <TextBlock Text="AI BRAINS STAY ISOLATED UNTIL MIX BUS"
                                               Foreground="{StaticResource GreenBrush}"
                                               FontSize="9"
                                               FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="source → specialist brains → explicit mix → master brain → output"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TinyLabel}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="GraphScroll"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="GraphScroll_ScrollChanged">
                        <controls:NodeGraphCanvas x:Name="GraphCanvas"
                                                  Width="2300"
                                                  Height="1200"
                                                  Graph="{Binding Graph}"
                                                  NodeToggled="GraphCanvas_NodeToggled"
                                                  NodeMoved="GraphCanvas_NodeMoved"
                                                  NodeDeleteRequested="GraphCanvas_NodeDeleteRequested"
                                                  NodeSelected="GraphCanvas_NodeSelected"
                                                  ConnectionChanged="GraphCanvas_ConnectionChanged"
                                                  ConnectionRejected="GraphCanvas_ConnectionRejected"/>
                    </ScrollViewer>

                    <!-- attached node inspector -->
                    <Popup x:Name="InspectorPopup"
                           PlacementTarget="{Binding ElementName=RootGrid}"
                           Placement="Relative"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           PopupAnimation="Fade">
                        <Border x:Name="InspectorCard"
                                Width="390"
                                MaxHeight="710"
                                Style="{StaticResource InspectorCard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="NODE CONTROL" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock Text="{Binding SelectedNode.Type}"
                                                       Style="{StaticResource TinyLabel}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="×"
                                                Width="32"
                                                Height="28"
                                                Padding="0"
                                                Click="CloseInspector_Click"/>
                                    </Grid>

                                    <TextBlock Text="Node name" Style="{StaticResource TinyLabel}" Margin="0,12,0,4"/>
                                    <TextBox Text="{Binding SelectedNode.Title, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Content="Enabled"
                                              IsChecked="{Binding SelectedNode.Enabled}"
                                              Margin="0,8,0,0"/>

                                    <!-- input -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}"
                                                                 Value="{x:Static models:AudioNodeType.Input}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="INPUT ENDPOINT" Style="{StaticResource SectionLabel}"/>
                                        <ComboBox ItemsSource="{Binding Sources}"
                                                  SelectedItem="{Binding SelectedNode.Endpoint, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="EndpointSelection_Changed"
                                                  Margin="0,7,0,4"/>
                                        <CheckBox Content="Treat as voice activity source"
                                                  IsChecked="{Binding SelectedNode.IsVoiceActivitySource}"/>
                                        <TextBlock Text="Input trim" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="-18" Maximum="24"
                                                Value="{Binding SelectedNode.Profile.InputGainDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.InputGainDb, StringFormat={}{0:F1} dB}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="Capture latency" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="10" Maximum="150"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding SelectedNode.LatencyMs}"/>
                                        <TextBlock Text="{Binding SelectedNode.LatencyMs, StringFormat={}{0} ms}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <!-- output -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}"
                                                                 Value="{x:Static models:AudioNodeType.Output}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="OUTPUT ENDPOINT" Style="{StaticResource SectionLabel}"/>
                                        <ComboBox ItemsSource="{Binding Outputs}"
                                                  SelectedItem="{Binding SelectedNode.Endpoint, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="EndpointSelection_Changed"
                                                  Margin="0,7,0,4"/>
                                        <TextBlock Text="Output latency" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="10" Maximum="150"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding SelectedNode.LatencyMs}"/>
                                        <TextBlock Text="{Binding SelectedNode.LatencyMs, StringFormat={}{0} ms}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <!-- AI specialist -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}"
                                                                 Value="{x:Static models:AudioNodeType.AiProcessor}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Border Background="#A3102527"
                                                BorderBrush="{StaticResource GreenBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="13"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="LOCAL AI SPECIALIST"
                                                                   Foreground="{StaticResource GreenBrush}"
                                                                   FontWeight="Black"
                                                                   FontSize="13"/>
                                                        <TextBlock Text="one independent brain for this node"
                                                                   Style="{StaticResource TinyLabel}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Background="#283AF0C4"
                                                            BorderBrush="{StaticResource GreenBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="8,4">
                                                        <TextBlock Text="{Binding SelectedNode.AiState}"
                                                                   Foreground="{StaticResource GreenBrush}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="Specialist task" Style="{StaticResource IntentLabel}"/>
                                                <ComboBox ItemsSource="{Binding AiSpecialists}"
                                                          SelectedItem="{Binding SelectedNode.AiSpecialist, Mode=TwoWay}"/>

                                                <TextBlock Text="What is flowing through this node?" Style="{StaticResource IntentLabel}"/>
                                                <ComboBox ItemsSource="{Binding AiContentModes}"
                                                          SelectedItem="{Binding SelectedNode.Profile.AiContentMode, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#A30C2221"
                                                BorderBrush="{StaticResource AquaBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="13"
                                                Margin="0,0,0,12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedNode.AiSpecialist}"
                                                                     Value="{x:Static models:MintAiSpecialist.Noise}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="AI NOISE FILTER"
                                                           Foreground="{StaticResource AquaBrush}"
                                                           FontWeight="Black"/>
                                                <TextBlock Text="Neural noise analysis drives a deterministic 512-point spectral mask. No generated replacement audio."
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource TinyLabel}"
                                                           Margin="0,3,0,7"/>
                                                <TextBlock Text="Maximum noise reduction" Style="{StaticResource IntentLabel}"/>
                                                <Slider Minimum="6" Maximum="36"
                                                        Value="{Binding SelectedNode.Profile.AiNoiseMaxReductionDb}"/>
                                                <TextBlock Text="{Binding SelectedNode.Profile.AiNoiseMaxReductionDb, StringFormat={}{0:F0} dB max}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="Noise sensitivity" Style="{StaticResource IntentLabel}"/>
                                                <Slider Minimum="0.05" Maximum="1"
                                                        Value="{Binding SelectedNode.Profile.AiNoiseSensitivity}"/>
                                                <TextBlock Text="{Binding SelectedNode.Profile.AiNoiseSensitivity, StringFormat={}{0:P0}}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="Protect speech / RVC character" Style="{StaticResource IntentLabel}"/>
                                                <Slider Minimum="0" Maximum="1"
                                                        Value="{Binding SelectedNode.Profile.AiNoiseSpeechProtection}"/>
                                                <TextBlock Text="{Binding SelectedNode.Profile.AiNoiseSpeechProtection, StringFormat={}{0:P0}}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="INTENT — tell the brain what you want"
                                                   Style="{StaticResource SectionLabel}"/>

                                        <TextBlock Text="Control strength" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="0" Maximum="1"
                                                Value="{Binding SelectedNode.Profile.AiStrength}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.AiStrength, StringFormat={}{0:P0}}"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Text="Naturalness / preserve original character" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="0" Maximum="1"
                                                Value="{Binding SelectedNode.Profile.AiNaturalness}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.AiNaturalness, StringFormat={}{0:P0}}"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Text="Maximum tonal correction (Tone / Cleanup / Master)" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="1" Maximum="12"
                                                Value="{Binding SelectedNode.Profile.AiMaxCorrectionDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.AiMaxCorrectionDb, StringFormat={}{0:F1} dB max}"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Text="Preserve transients / punch" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="0" Maximum="1"
                                                Value="{Binding SelectedNode.Profile.AiPreserveTransients}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.AiPreserveTransients, StringFormat={}{0:P0}}"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Text="Consistency / set-and-forget pressure" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="0" Maximum="1"
                                                Value="{Binding SelectedNode.Profile.AiConsistency}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.AiConsistency, StringFormat={}{0:P0}}"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Text="Target loudness (used by Loudness brain)" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="-30" Maximum="-12"
                                                Value="{Binding SelectedNode.Profile.AiTargetLoudnessDb}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.AiTargetLoudnessDb, StringFormat={}{0:F1} dB target}"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Text="Learning / adaptation speed" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="0" Maximum="1"
                                                Value="{Binding SelectedNode.Profile.AiAdaptation}"/>
                                        <TextBlock Text="{Binding SelectedNode.Profile.AiAdaptation, StringFormat={}{0:P0}}"
                                                   HorizontalAlignment="Right"/>

                                        <Border Background="#B70A171C"
                                                BorderBrush="{StaticResource PurpleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="13"
                                                Margin="0,14,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="LIVE BRAIN TELEMETRY"
                                                               Foreground="{StaticResource PurpleBrush}"
                                                               FontWeight="Black"/>
                                                    <TextBlock Text="{Binding SelectedNode.AiConfidenceText}"
                                                               HorizontalAlignment="Right"
                                                               Style="{StaticResource TinyLabel}"/>
                                                </Grid>
                                                <ProgressBar Height="7"
                                                             Maximum="1"
                                                             Value="{Binding SelectedNode.AiConfidence, Mode=OneWay}"
                                                             Margin="0,7,0,9"/>
                                                <TextBlock Text="HEARD" Style="{StaticResource TinyLabel}"/>
                                                <TextBlock Text="{Binding SelectedNode.AiHeard}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,8"/>
                                                <TextBlock Text="DECISION" Style="{StaticResource TinyLabel}"/>
                                                <TextBlock Text="{Binding SelectedNode.AiAction}"
                                                           Foreground="{StaticResource GreenBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Expander Header="EXPERT GUARDRAILS / STARTING DSP"
                                                  Margin="0,12,0,0">
                                            <StackPanel Margin="6,8,2,0">
                                                <TextBlock Text="These are the deterministic DSP starting points. The AI owns a private runtime copy and may move it only within its intent limits."
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource TinyLabel}"
                                                           Margin="0,0,0,7"/>
                                                <TextBlock Text="Gate floor" Style="{StaticResource IntentLabel}"/>
                                                <Slider Minimum="-72" Maximum="-20"
                                                        Value="{Binding SelectedNode.Profile.GateThresholdDb}"/>
                                                <TextBlock Text="High-pass" Style="{StaticResource IntentLabel}"/>
                                                <Slider Minimum="30" Maximum="220"
                                                        Value="{Binding SelectedNode.Profile.HighPassHz}"/>
                                                <TextBlock Text="De-ess baseline" Style="{StaticResource IntentLabel}"/>
                                                <Slider Minimum="0" Maximum="1"
                                                        Value="{Binding SelectedNode.Profile.DeEsserAmount}"/>
                                                <TextBlock Text="Compression baseline" Style="{StaticResource IntentLabel}"/>
                                                <Slider Minimum="0" Maximum="1"
                                                        Value="{Binding SelectedNode.Profile.Compression}"/>
                                                <TextBlock Text="Limiter ceiling baseline" Style="{StaticResource IntentLabel}"/>
                                                <Slider Minimum="-6" Maximum="-0.1"
                                                        Value="{Binding SelectedNode.Profile.LimiterCeilingDb}"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>

                                    <!-- sidechain -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}"
                                                                 Value="{x:Static models:AudioNodeType.Ducker}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="SIDECHAIN DUCKER" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="MAIN carries audible program audio. SIDECHAIN is analyzed only and is never summed into MAIN."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource TinyLabel}"
                                                   Margin="0,5,0,7"/>
                                        <TextBlock Text="Duck depth" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="-30" Maximum="0"
                                                Value="{Binding SelectedNode.Profile.DuckingDb}"/>
                                        <TextBlock Text="Trigger threshold" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="-72" Maximum="-6"
                                                Value="{Binding SelectedNode.Profile.DuckerThresholdDb}"/>
                                        <TextBlock Text="Attack" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="1" Maximum="500"
                                                Value="{Binding SelectedNode.Profile.DuckerAttackMs}"/>
                                        <TextBlock Text="Release" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="20" Maximum="3000"
                                                Value="{Binding SelectedNode.Profile.DuckerReleaseMs}"/>
                                    </StackPanel>

                                    <!-- mixer -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel" BasedOn="{StaticResource InspectorSection}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}"
                                                                 Value="{x:Static models:AudioNodeType.Mixer}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="EXPLICIT MIX BUS" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="This is the only node allowed to sum multiple audible inputs. Everything upstream remains isolated."
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource TinyLabel}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- manual DSP controls -->
                                    <StackPanel Margin="0,12,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Input}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Output}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.AiProcessor}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Mixer}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedNode.Type}" Value="{x:Static models:AudioNodeType.Ducker}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="MANUAL DSP NODE" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="Expert fallback: deterministic controls with no neural decision layer."
                                                   Style="{StaticResource TinyLabel}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,7"/>
                                        <TextBlock Text="Input gain" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="-24" Maximum="24" Value="{Binding SelectedNode.Profile.InputGainDb}"/>
                                        <TextBlock Text="High-pass" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="30" Maximum="220" Value="{Binding SelectedNode.Profile.HighPassHz}"/>
                                        <TextBlock Text="De-esser" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding SelectedNode.Profile.DeEsserAmount}"/>
                                        <TextBlock Text="Low EQ" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="-12" Maximum="12" Value="{Binding SelectedNode.Profile.LowGainDb}"/>
                                        <TextBlock Text="Mid EQ" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="-12" Maximum="12" Value="{Binding SelectedNode.Profile.MidGainDb}"/>
                                        <TextBlock Text="High EQ" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="-12" Maximum="12" Value="{Binding SelectedNode.Profile.HighGainDb}"/>
                                        <TextBlock Text="Compression" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="0" Maximum="1" Value="{Binding SelectedNode.Profile.Compression}"/>
                                        <TextBlock Text="Level target" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="-32" Maximum="-12" Value="{Binding SelectedNode.Profile.TargetDb}"/>
                                        <TextBlock Text="Limiter ceiling" Style="{StaticResource IntentLabel}"/>
                                        <Slider Minimum="-12" Maximum="-0.1" Value="{Binding SelectedNode.Profile.LimiterCeilingDb}"/>
                                    </StackPanel>

                                    <Button Content="DELETE NODE"
                                            Margin="0,16,0,0"
                                            Background="#381722"
                                            BorderBrush="{StaticResource HotBrush}"
                                            Click="DeleteSelected_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- transport -->
            <Border Grid.Row="3"
                    Background="#D90A1518"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,18,18">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="START MINT"
                                Style="{StaticResource PrimaryButton}"
                                Width="138"
                                Height="50"
                                Click="Start_Click"/>
                        <Button Content="STOP"
                                Width="74"
                                Height="50"
                                Margin="8,0,0,0"
                                Click="Stop_Click"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="30,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="54"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="VOICE" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="0" Grid.Column="1" Height="8" Maximum="100"
                                     Value="{Binding VoiceMeter, Mode=OneWay}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding VoiceMeter, StringFormat={}{0:F0}%}"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1" Text="PROGRAM" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" Height="8" Maximum="100"
                                     Value="{Binding ProgramMeter, Mode=OneWay}"
                                     Foreground="{StaticResource PurpleBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="{Binding ProgramMeter, StringFormat={}{0:F0}%}"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2" Text="MASTER" Style="{StaticResource TinyLabel}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="2" Grid.Column="1" Height="8" Maximum="100"
                                     Value="{Binding MasterMeter, Mode=OneWay}"
                                     Foreground="{StaticResource HotBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   Text="{Binding MasterMeter, StringFormat={}{0:F0}%}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="48 kHz • 32-bit float"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="neural control • deterministic audio • hard loop guards"
                                   Style="{StaticResource TinyLabel}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

